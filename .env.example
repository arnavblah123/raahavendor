# Copy this file to .env.local and paste in your own two values.
#
# Both come from your Supabase project:
#   Supabase dashboard -> Project Settings -> API
#
# These two are the ONLY settings the app needs. There are no paid services,
# no SMS gateway and no WhatsApp API key — WhatsApp messages open in your own
# WhatsApp with the text already written.

# "Project URL" — looks like https://abcdefghijkl.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# "anon public" key — a long string starting with eyJ...
# This one is safe to expose in the browser. Row Level Security is what
# actually protects your data.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Do NOT put the "service_role" key anywhere in this project.
# The app never needs it, and it would bypass all your security rules.
