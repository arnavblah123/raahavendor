# Copy this file to .env.local and paste in your own two values.
#
# Both come from your Supabase project:
#   Supabase dashboard -> Project Settings -> API Keys
#
# These two are the ONLY settings the app needs. There are no paid services,
# no SMS gateway and no WhatsApp API key — WhatsApp messages open in your own
# WhatsApp with the text already written.

# "Project URL" — looks like https://abcdefghijkl.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# The browser-safe key. On the "API Keys" tab this is the
# "Publishable key" and starts with sb_publishable_
#
# It is meant to be visible in the browser. Row Level Security is what
# actually protects your data.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Only for Supabase projects created before November 2025, which have an
# "anon public" key instead of a publishable one. Leave this blank if you
# filled in the line above.
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Do NOT put a "Secret key" (sb_secret_...) or a "service_role" key anywhere
# in this project. The app never needs one, and it would bypass every
# security rule you just set up.
